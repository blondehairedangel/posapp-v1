# ===========================================================================
# Copy to .env and fill in. NEVER commit a real .env.
# Every value below is a placeholder.
# ===========================================================================

# --------------------------------- Core ------------------------------------
NODE_ENV=development
# Public base URL. Must be the HTTPS origin in production; it is used to build
# webhook callback URLs and links inside outbound email.
APP_URL=http://localhost:3000
APP_NAME="Spare Parts ERP"
# Display timezone. Timestamps are always STORED in UTC.
APP_TIMEZONE=Asia/Jakarta
APP_CURRENCY=IDR
APP_LOCALE=id-ID

# ------------------------------- Database ----------------------------------
# PRECEDENCE (documented and deterministic):
#   1. DATABASE_URL, if set, is the source of truth. The DB_* variables below
#      are then IGNORED ENTIRELY — not merged — because a half-applied
#      override is impossible to debug when a connection fails.
#   2. Otherwise the URL is composed from DB_HOST / DB_PORT / DB_NAME /
#      DB_USER / DB_PASSWORD.
#   3. Otherwise the app refuses to start. There is deliberately NO localhost
#      fallback: silently connecting to an unintended database is worse than
#      failing loudly.
#
# Both forms work for the application AND for `prisma migrate`.
# Check which target is resolved at any time with:  pnpm db:target
#
# --- Option 1: single connection string --------------------------------------
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://erp:CHANGE_ME@localhost:5432/sparepart_erp?schema=public

# --- Option 2: individual parts (leave DATABASE_URL unset to use these) ------
# Credentials are percent-encoded automatically, so a password containing
# @ : / ? # % needs no manual escaping here. (Inside DATABASE_URL it does.)
#DB_HOST=postgres
#DB_PORT=5432
#DB_NAME=sparepart_erp
#DB_USER=erp
#DB_PASSWORD=
#DB_SCHEMA=public

# --- Choosing HOST -----------------------------------------------------------
#   Same Compose project .......... the service name, e.g. "postgres"
#   Another Compose project ....... its service name + a shared external
#                                   network (see docker-compose.yml)
#   PostgreSQL on the Docker host . host.docker.internal
#                                   (Linux also needs extra_hosts, see compose)
#   Another VPS / managed ......... the hostname or private IP, plus TLS below
#   Local dev without Docker ...... 127.0.0.1 port 5433 (pnpm db:start)
#
# --- TLS (required for anything crossing a network) --------------------------
# disable | allow | prefer | require | verify-ca | verify-full
#   require     encrypts but does NOT authenticate the server (MITM possible)
#   verify-full encrypts AND verifies hostname + CA — use this across a WAN
#DB_SSLMODE=verify-full
# PEM CA bundle, mounted into the container and readable by the app user.
#DB_SSL_ROOT_CERT=/etc/ssl/certs/pg-ca.crt

# --- Connection pool ---------------------------------------------------------
# Per application process. web + worker each open their own pool, so the
# server must allow at least (DB_POOL_MAX x processes) connections. Keep this
# well under PostgreSQL's max_connections, or put PgBouncer in front.
#DB_POOL_MAX=10
#DB_CONNECT_TIMEOUT_MS=10000
#DB_IDLE_TIMEOUT_MS=30000

# --------------------- Bundled database only (optional) --------------------
# Used ONLY by docker-compose.postgres.yml to initialise the bundled server.
# Ignore these entirely if you run your own PostgreSQL.
# POSTGRES_PASSWORD must match the password in DATABASE_URL / DB_PASSWORD.
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=sparepart_erp

# Host port the web UI is published on (ignored behind a reverse proxy).
WEB_PORT=3000

# ------------------------------- Guard rails -------------------------------
# Leave UNSET. It is the explicit opt-in that allows destructive commands
# (prisma migrate reset) to run against a non-loopback database.
#DB_ALLOW_DESTRUCTIVE=

# -------------------------------- Secrets ----------------------------------
# Generate each with: openssl rand -base64 48
# Signs session cookies.
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# AES-256-GCM key for secrets stored in the DB (channel tokens, mailbox
# passwords). MUST be exactly 32 bytes, base64-encoded: openssl rand -base64 32
# Rotating this invalidates every stored secret.
APP_ENCRYPTION_KEY=CHANGE_ME_base64_of_exactly_32_random_bytes
# Session lifetime in hours.
SESSION_TTL_HOURS=12

# ------------------------------ File storage -------------------------------
# "local" | "s3"
STORAGE_DRIVER=local
# Used when STORAGE_DRIVER=local. Must be a mounted volume in production.
STORAGE_LOCAL_PATH=./storage
# Used when STORAGE_DRIVER=s3 (works with MinIO / R2 / Spaces).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Max upload / inbound attachment size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760

# ----------------------------- Background jobs -----------------------------
# pg-boss stores its queue inside the same PostgreSQL instance, in its own
# schema, so no Redis is required.
JOB_SCHEMA=pgboss
# Set to false on web replicas if you run the worker as a separate service.
JOB_WORKER_ENABLED=true
# How often the IMAP poller runs, in seconds.
EMAIL_POLL_INTERVAL_SECONDS=60

# ---------------------- WhatsApp Business Cloud API ------------------------
# Leave blank to keep the channel disabled. The app will NOT pretend to send.
# From Meta: App Dashboard -> WhatsApp -> API Setup.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# You choose this string; paste the same value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret - used to verify the X-Hub-Signature-256 header. Inbound
# webhooks are REJECTED when this is unset in production.
WHATSAPP_APP_SECRET=

# ------------------------------ Email (SMTP) -------------------------------
# Outbound. Inbound mailboxes (IMAP) are configured per-department in the app
# UI under Integrations, because each department can own its own mailbox.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Spare Parts Sales"
SMTP_FROM_ADDRESS=

# --------------------------- AI order extraction ---------------------------
# The whole ERP works with this disabled; a deterministic SKU/quantity parser
# is used as the fallback. No third-party AI key is required to operate.
AI_EXTRACTION_ENABLED=false
# "openai" | "anthropic" | "openai-compatible" | "none"
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# For self-hosted / proxy endpoints (vLLM, Ollama, OpenRouter...).
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
# Matches at or above this score are auto-applied; below it a human must review.
EXTRACTION_AUTO_MATCH_THRESHOLD=0.92
EXTRACTION_SUGGEST_THRESHOLD=0.45

# -------------------------------- Security ---------------------------------
# Requests per minute, per IP, on auth endpoints and public webhooks.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=600
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info
