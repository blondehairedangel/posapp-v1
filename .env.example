# ===========================================================================
# Copy to .env and fill in. NEVER commit a real .env.
# Every value below is a placeholder.
# ===========================================================================

# --------------------------------- Core ------------------------------------
NODE_ENV=development
# Public base URL. Must be the HTTPS origin in production; it is used to build
# webhook callback URLs and links inside outbound email.
APP_URL=http://localhost:3000
APP_NAME="Spare Parts ERP"
# Display timezone. Timestamps are always STORED in UTC.
APP_TIMEZONE=Asia/Jakarta
APP_CURRENCY=IDR
APP_LOCALE=id-ID

# ------------------------------- Database ----------------------------------
# THE single place the database and its password are configured. Nothing
# overrides this — docker-compose.yml reads it from here and does not set it.
#
# Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
#
# Pick the HOST that matches where your PostgreSQL runs:
#
#   1. Your own PostgreSQL in ANOTHER compose stack
#      Use its service name, and join its network (see docker-compose.yml,
#      "Reaching a PostgreSQL that lives in ANOTHER compose project"):
#      DATABASE_URL=postgresql://erp:secret@postgres:5432/sparepart_erp?schema=public
#
#   2. PostgreSQL on the Docker HOST (installed natively, or a published port)
#      Linux: add to the web/worker/migrate services in docker-compose.yml:
#        extra_hosts: ['host.docker.internal:host-gateway']
#      Docker Desktop (macOS/Windows) resolves it already.
#      DATABASE_URL=postgresql://erp:secret@host.docker.internal:5432/sparepart_erp?schema=public
#
#   3. Managed / remote PostgreSQL (RDS, Neon, Supabase, a separate server)
#      Most require TLS; add sslmode=require.
#      DATABASE_URL=postgresql://erp:secret@db.example.com:5432/sparepart_erp?sslmode=require&schema=public
#
#   4. The bundled container (docker-compose.postgres.yml)
#      Host is the service name "postgres". The password must equal
#      POSTGRES_PASSWORD below.
#      DATABASE_URL=postgresql://erp:secret@postgres:5432/sparepart_erp?schema=public
#
#   5. Local development without Docker (pnpm db:start)
#      DATABASE_URL=postgresql://postgres@127.0.0.1:5433/sparepart_erp?schema=public
#
# If the password contains @ : / ? # or %, percent-encode it
# (@ -> %40, : -> %3A, / -> %2F, ? -> %3F, # -> %23, % -> %25), otherwise the
# URL parser will misread the host.
#
# Required privileges: the user must be able to CREATE TABLE in the target
# database and CREATE SCHEMA — the background job queue (pg-boss) creates and
# owns its own "pgboss" schema there. Being the database owner is sufficient.
DATABASE_URL=postgresql://erp:CHANGE_ME@localhost:5432/sparepart_erp?schema=public

# --------------------- Bundled database only (optional) --------------------
# Used ONLY by docker-compose.postgres.yml to initialise the bundled server.
# Ignore these if you run your own PostgreSQL. POSTGRES_PASSWORD must match
# the password inside DATABASE_URL above.
POSTGRES_USER=erp
POSTGRES_PASSWORD=
POSTGRES_DB=sparepart_erp

# Host port the web UI is published on (ignored behind a reverse proxy).
WEB_PORT=3000

# -------------------------------- Secrets ----------------------------------
# Generate each with: openssl rand -base64 48
# Signs session cookies.
SESSION_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
# AES-256-GCM key for secrets stored in the DB (channel tokens, mailbox
# passwords). MUST be exactly 32 bytes, base64-encoded: openssl rand -base64 32
# Rotating this invalidates every stored secret.
APP_ENCRYPTION_KEY=CHANGE_ME_base64_of_exactly_32_random_bytes
# Session lifetime in hours.
SESSION_TTL_HOURS=12

# ------------------------------ File storage -------------------------------
# "local" | "s3"
STORAGE_DRIVER=local
# Used when STORAGE_DRIVER=local. Must be a mounted volume in production.
STORAGE_LOCAL_PATH=./storage
# Used when STORAGE_DRIVER=s3 (works with MinIO / R2 / Spaces).
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Max upload / inbound attachment size in bytes (default 10 MiB).
MAX_UPLOAD_BYTES=10485760

# ----------------------------- Background jobs -----------------------------
# pg-boss stores its queue inside the same PostgreSQL instance, in its own
# schema, so no Redis is required.
JOB_SCHEMA=pgboss
# Set to false on web replicas if you run the worker as a separate service.
JOB_WORKER_ENABLED=true
# How often the IMAP poller runs, in seconds.
EMAIL_POLL_INTERVAL_SECONDS=60

# ---------------------- WhatsApp Business Cloud API ------------------------
# Leave blank to keep the channel disabled. The app will NOT pretend to send.
# From Meta: App Dashboard -> WhatsApp -> API Setup.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
# You choose this string; paste the same value into Meta's webhook config.
WHATSAPP_VERIFY_TOKEN=
# Meta App Secret - used to verify the X-Hub-Signature-256 header. Inbound
# webhooks are REJECTED when this is unset in production.
WHATSAPP_APP_SECRET=

# ------------------------------ Email (SMTP) -------------------------------
# Outbound. Inbound mailboxes (IMAP) are configured per-department in the app
# UI under Integrations, because each department can own its own mailbox.
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Spare Parts Sales"
SMTP_FROM_ADDRESS=

# --------------------------- AI order extraction ---------------------------
# The whole ERP works with this disabled; a deterministic SKU/quantity parser
# is used as the fallback. No third-party AI key is required to operate.
AI_EXTRACTION_ENABLED=false
# "openai" | "anthropic" | "openai-compatible" | "none"
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
# For self-hosted / proxy endpoints (vLLM, Ollama, OpenRouter...).
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
# Matches at or above this score are auto-applied; below it a human must review.
EXTRACTION_AUTO_MATCH_THRESHOLD=0.92
EXTRACTION_SUGGEST_THRESHOLD=0.45

# -------------------------------- Security ---------------------------------
# Requests per minute, per IP, on auth endpoints and public webhooks.
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=600
# Set true only behind a trusted reverse proxy that sets X-Forwarded-For.
TRUST_PROXY=false
LOG_LEVEL=info
