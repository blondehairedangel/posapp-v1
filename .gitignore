# dependencies
node_modules/
.pnpm-store/

# next.js
/.next/
/out/
next-env.d.ts

# production
/build
/dist

# Secrets — never commit a real environment file.
#
# Rule order matters: deny every .env variant, then re-allow the committed
# TEMPLATES. The negation pattern is `*.example` rather than a list, so a new
# template (.env.staging.example) is tracked automatically while the real
# .env.staging stays ignored.
.env
.env.*
!.env*.example

# local development postgres cluster + downloaded binaries
/.devdata/

# locally stored attachments (STORAGE_DRIVER=local)
/storage/

# generated prisma client
/src/generated/

# Local editor/agent settings. Shared steering and hooks under .kiro/ are
# intentionally NOT ignored — only machine-local settings are.
/.kiro/settings/

# misc
.DS_Store
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vercel
*.tsbuildinfo

# test output
/coverage/
