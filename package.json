{
  "name": "sparepart-erp",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "worker": "tsx src/server/jobs/worker.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/reset-test-db.mjs && vitest run",
    "test:only": "vitest run",
    "test:watch": "vitest",
    "smoke:workflow": "tsx scripts/smoke-workflow.mts",
    "smoke:webhook": "node scripts/smoke-webhook.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.mts",
    "db:start": "bash scripts/dev-postgres.sh start",
    "db:stop": "bash scripts/dev-postgres.sh stop"
  },
  "prisma": {
    "seed": "tsx prisma/seed.mts"
  },

  "dependencies": {
    "@hookform/resolvers": "6.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@radix-ui/react-checkbox": "1.3.3",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.1.17",
    "@radix-ui/react-label": "2.1.8",
    "@radix-ui/react-popover": "1.1.16",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-separator": "1.1.8",
    "@radix-ui/react-slot": "1.2.4",
    "@radix-ui/react-tabs": "1.1.13",
    "@radix-ui/react-tooltip": "1.2.9",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "18.0.8",
    "exceljs": "4.4.0",
    "imapflow": "2.8.0",
    "lucide-react": "1.61.0",
    "mailparser": "3.10.0",
    "next": "16.4.2",
    "nodemailer": "10.1.7",
    "pdfkit": "0.20.2",
    "pg-boss": "12.38.0",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "sanitize-html": "2.18.1",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.5"
  }
}
