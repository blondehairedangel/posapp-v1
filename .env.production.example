# ===========================================================================
# PRODUCTION environment template.
#
# Copy to `.env` on the production host (or paste into your platform's secret
# manager — Coolify, Portainer, systemd EnvironmentFile, Docker secrets) and
# replace every CHANGE_ME.
#
# This file is a TEMPLATE and is committed. `.env` is NOT committed.
# Never put a real credential in this file.
#
# Differences from .env.example:
#   - NODE_ENV=production, so cookies are Secure and dev conveniences are off
#   - TLS to the database is required rather than optional
#   - the worker runs as its own process, so JOB_WORKER_ENABLED differs per
#     service (false on web replicas, true on the worker)
# ===========================================================================

NODE_ENV=production

# --------------------------------- Core ------------------------------------
# MUST be the public HTTPS origin. It builds the WhatsApp callback URL and the
# links inside outbound email; an http:// value here also means session
# cookies are issued without Secure.
APP_URL=https://erp.example.com
APP_NAME="Spare Parts ERP"
APP_TIMEZONE=Asia/Jakarta
APP_CURRENCY=IDR
APP_LOCALE=id-ID

# ------------------------------- Database ----------------------------------
# DATABASE_URL wins over the DB_* parts; set one form, not both.
# Verify what the app will actually use:  pnpm db:target
#
# Percent-encode the password inside the URL if it contains @ : / ? # %
# (@ -> %40, : -> %3A, / -> %2F, ? -> %3F, # -> %23, % -> %25).
DATABASE_URL=postgresql://erp_app:CHANGE_ME@db.internal.example.com:5432/sparepart_erp?schema=public&sslmode=verify-full

# Or, equivalently (no manual escaping needed in this form):
#DB_HOST=db.internal.example.com
#DB_PORT=5432
#DB_NAME=sparepart_erp
#DB_USER=erp_app
#DB_PASSWORD=CHANGE_ME
#DB_SSLMODE=verify-full

# Across any network boundary use verify-full, not require: `require`
# encrypts but does not authenticate the server, so it does not stop an
# active man-in-the-middle. verify-full needs the CA that signed the server
# certificate, mounted read-only into the container.
DB_SSL_ROOT_CERT=/etc/ssl/certs/pg-ca.crt

# Per process. web and worker each hold their own pool, so size this against
# the server's max_connections: (DB_POOL_MAX x web replicas) + worker pool
# must stay comfortably below it. Use PgBouncer if you need more.
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000

# -------------------------------- Secrets ----------------------------------
# Generate fresh values per environment; never reuse staging secrets here.
#   openssl rand -base64 48   -> SESSION_SECRET
#   openssl rand -base64 32   -> APP_ENCRYPTION_KEY (must decode to 32 bytes)
SESSION_SECRET=CHANGE_ME_openssl_rand_base64_48
# Encrypts channel tokens and mailbox passwords at rest. BACK THIS UP: losing
# it makes every stored integration credential undecryptable, and rotating it
# invalidates them all.
APP_ENCRYPTION_KEY=CHANGE_ME_base64_of_exactly_32_random_bytes
SESSION_TTL_HOURS=12

# ------------------------------ File storage -------------------------------
STORAGE_DRIVER=local
# Must be a mounted persistent volume, not a path inside the image.
STORAGE_LOCAL_PATH=/app/storage
MAX_UPLOAD_BYTES=10485760

# ----------------------------- Background jobs -----------------------------
# pg-boss creates and owns this schema in the SAME database, so the database
# user needs CREATE SCHEMA (being the database owner is enough).
JOB_SCHEMA=pgboss
# true ONLY on the dedicated worker service. Set false on web replicas so they
# do not also claim jobs. docker-compose.yml already does this per service.
JOB_WORKER_ENABLED=false
EMAIL_POLL_INTERVAL_SECONDS=60

# ---------------------- WhatsApp Business Cloud API ------------------------
# Leave blank to keep the channel disabled; the app will not pretend to send.
WHATSAPP_ENABLED=false
WHATSAPP_API_VERSION=v21.0
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_VERIFY_TOKEN=
# REQUIRED in production: without it, inbound webhooks are rejected, because
# an unsigned webhook would let anyone inject messages into the ticket system.
WHATSAPP_APP_SECRET=

# ------------------------------ Email --------------------------------------
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME="Spare Parts Sales"
SMTP_FROM_ADDRESS=

# --------------------------- AI order extraction ---------------------------
# Optional. With this off, extraction uses the deterministic parser and the
# whole ordering workflow still functions.
AI_EXTRACTION_ENABLED=false
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_MAX_RETRIES=2
EXTRACTION_AUTO_MATCH_THRESHOLD=0.92
EXTRACTION_SUGGEST_THRESHOLD=0.45

# -------------------------------- Security ---------------------------------
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_WEBHOOK_PER_MINUTE=600
# Enable ONLY behind a reverse proxy that overwrites X-Forwarded-For.
# Enabling it on a directly exposed server lets clients spoof their IP and
# defeat the auth rate limiter.
TRUST_PROXY=true
LOG_LEVEL=info

# ------------------------------- Guard rails -------------------------------
# Leave UNSET in production. It is the opt-in that allows destructive
# commands (prisma migrate reset) against a non-local database.
#DB_ALLOW_DESTRUCTIVE=
